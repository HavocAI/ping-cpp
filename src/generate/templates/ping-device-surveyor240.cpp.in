#include <ping-message-common.h>
#include "ping-message-surveyor240.h"
#include "ping-device-surveyor240.h"

Surveyor240::~Surveyor240()
{
{% for msg in messages["get"]|sort %}
{% for field in messages["get"][msg].payload %}
{% if field.type == "vector" %}
    if ({{ msg }}_data.{{ generator.escape_reserved(field.name) }}) {
        delete[] {{ msg }}_data.{{ generator.escape_reserved(field.name) }};
    }
{% endif %}
{% endfor %}
{% endfor %}
}

bool Surveyor240::initialize()
{
    if (!PingDevice::initialize()) {
        return false;
    }
    return true;
}

void Surveyor240::_handleMessage(const ping_message* message)
{
    switch (message->message_id()) {
{% for msg in messages["get"]|sort %}
{% if not messages["get"][msg].deprecated %}
    case Surveyor240Id::{{ msg|upper }}:
    {
        const surveyor240_{{ msg }}* message_{{ msg }} = static_cast<const surveyor240_{{ msg }}*>(message);
{% for field in messages["get"][msg].payload %}
{% if field.type == "vector" %}
        if (message_{{ msg }}->{{ field.name }}_length() > {{ msg }}_data.{{ field.name }}_length) {
            if ({{ msg }}_data.{{ generator.escape_reserved(field.name) }}) {
                delete[] {{ msg }}_data.{{ generator.escape_reserved(field.name) }};
            }
            {{ msg }}_data.{{ generator.escape_reserved(field.name) }} = new {{ field.vector.datatype }}[message_{{ msg }}->{{ field.name }}_length()];
        }
        {{ msg }}_data.{{ field.name }}_length = message_{{ msg }}->{{ field.name }}_length();
        memcpy({{ msg }}_data.{{ generator.escape_reserved(field.name) }}, message_{{ msg }}->{{ generator.escape_reserved(field.name) }}(), message_{{ msg }}->{{ field.name }}_length());
{% else %}
        {{ msg }}_data.{{ generator.escape_reserved(field.name) }} = message_{{ msg }}->{{ generator.escape_reserved(field.name) }}();
{% endif %}
{% endfor %}
    }
    break;
{% endif %}
{% endfor %}

    default:
        break;
    }

    PingDevice::_handleMessage(message);
}

{% for msg in messages["control"]|sort %}
void Surveyor240::set_{{ msg }}({% for field in messages["control"][msg].payload %}{{ generator.get_type_string(field.type) }} _{{ generator.escape_reserved(field.name) }}{{ ", " if not loop.last else "" }}{% endfor %})
{
    surveyor240_{{ msg }} message;
{% for field in messages["control"][msg].payload %}
    message.set_{{ generator.escape_reserved(field.name) }}(_{{ generator.escape_reserved(field.name) }});
{% endfor %}
    writeMessage(message);
}

{% endfor %}
